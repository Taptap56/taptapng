<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsible section header for the Settings screen (v1.0.5,
     restyled v1.0.27 to match v2rayNG's CollapsiblePreferenceGroupHeader:
     titleSmall (14sp, medium weight) in secondary (orange), 16dp
     horizontal / 12dp vertical padding, chevron tinted secondary and
     rotating 180 deg when expanded (rotation set in the adapter). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorSecondary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/section_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:src="@drawable/ic_expand_more_24dp"
        android:tint="?attr/colorSecondary" />
</LinearLayout>
