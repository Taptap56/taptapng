<?xml version="1.0" encoding="utf-8"?>
<!-- One proxy group row: name + type, member count + selected member. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- v1.0.26 (bug 1 of 3): the name used the undefined
                 ?attr/textAppearanceTitleSmall — assigned nowhere
                 in the shipped APK (aapt2 dump resources on
                 v1.0.25), so it resolved to ID 0 and rendered tiny
                 and dim next to the full-size type ("taptap SELECT",
                 05:03 screenshot). BodyLarge is the defined 16sp
                 onSurface style (v1.0.25 section labels, server-row
                 name). The name is also bounded 0dp + weight 1 +
                 ellipsize + maxLines 1 (the remarks pattern in
                 item_server.xml): the NAME yields, never the type —
                 before, both were unbounded wrap_content, so a long
                 name shoved the type out of the row. -->
            <TextView
                android:id="@+id/group_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/group_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/group_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/group_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/groups_edit"
        android:src="@drawable/ic_edit_24dp" />

    <ImageButton
        android:id="@+id/group_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/groups_delete"
        android:src="@drawable/ic_delete_24dp" />
</LinearLayout>
