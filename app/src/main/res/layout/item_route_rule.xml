<?xml version="1.0" encoding="utf-8"?>
<!-- One route rule row: type + pattern, target, on/off toggle.
     FINAL ("Rute akhir") has no toggle — it is always active. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rule_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/rule_pattern"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceTitleSmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/rule_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <!-- On/off toggle (v1.0.23) + reorder (v1.0.23): up/down move
         the rule one step in the top-down match order. At the edges
         the button is disabled (dimmed), never hidden, so the row
         layout stays stable. -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/rule_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:contentDescription="@string/groups_rule_enabled"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track" />

    <ImageButton
        android:id="@+id/rule_move_up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/groups_move_up"
        android:src="@drawable/ic_arrow_up_24dp"
        android:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/rule_move_down"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/groups_move_down"
        android:src="@drawable/ic_arrow_down_24dp"
        android:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/rule_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/groups_edit"
        android:src="@drawable/ic_edit_24dp"
        android:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/rule_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/groups_delete"
        android:src="@drawable/ic_delete_24dp"
        android:tint="?attr/colorOnSurface" />
</LinearLayout>
