<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Views theme mirroring v2rayNG: black primary, green secondary
         (TB/TC accent: #22e6a8 dark / #0fb88a light, v1.0.28 — dulu
         oranye #f97910), green tertiary (#009966). Material Components
         DayNight so the stored theme mode (system/light/dark) applies. -->
    <style name="Theme.TaptapNG" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="android:textColorPrimary">@color/onSurface</item>
        <item name="android:textColorSecondary">@color/onSurfaceVariant</item>
        <!-- M3 typography (v1.0.4): the layouts + androidx.preference
             1.2.1 use textAppearanceBodyLarge/Medium/Small and
             textAppearanceTitleLarge, but Theme.MaterialComponents
             (M2) does NOT define them — they resolved to resource ID
             0, so every TextView using them logged "Invalid resource
             ID 0x00000000" (the Settings flood) and fell back to the
             small default size. Defining them here (M3-standard sizes
             + theme-adaptive colors) fixes both. -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TaptapNG.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TaptapNG.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.TaptapNG.BodySmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TaptapNG.TitleLarge</item>
        <!-- dynamicColorThemeOverlay (v1.0.5): Theme.MaterialComponents
             (M2) does NOT define this attribute — only M3 themes do —
             but TaptapNGApp registers DynamicColors.applyToActivitiesIfAvailable
             (dynamic_color default ON, SDK 31+). Material 1.13.0 resolves
             the overlay from this attribute and calls
             theme.applyStyle(id, true) WITHOUT a zero check, so the
             undefined attribute resolved to resource ID 0 and EVERY
             activity creation logged one "Invalid resource ID 0x00000000"
             (proven from the shipped v1.0.4 APK: aapt2 dump shows the
             attribute never assigned anywhere; dexdump of the shipped
             DynamicColors callback shows getResourceId(0, 0) followed
             by applyStyle(v7, true) with no zero guard). Defining it
             here with an intentionally EMPTY overlay makes applyStyle a
             no-op: the error disappears and the fixed v2rayNG palette is
             untouched. Do NOT point this at
             ThemeOverlay.Material3.DynamicColors — that would recolor
             the app with wallpaper-derived Material You colors. -->
        <item name="dynamicColorThemeOverlay">@style/ThemeOverlay.TaptapNG.DynamicColors</item>
    </style>

    <!-- M3 typography tokens for the M2 theme (see above). Colors use
         ?attr/colorOnSurface(Variant) so they adapt to light/dark. -->
    <style name="TextAppearance.TaptapNG.BodyLarge" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.TaptapNG.BodyMedium" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.TaptapNG.BodySmall" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.TaptapNG.TitleLarge" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- M3 FilterChip v2rayNG di atas tema M2 (v1.0.26): v2rayNG
         memakai M3 FilterChip dalam FlowRow (jarak 8dp) — tidak
         terpilih = isi transparan + garis outline 1dp, terpilih =
         isi secondaryContainer + ikon centang + teks
         onSecondaryContainer. Tema M2 tidak punya peran warna M3,
         jadi nilai disalin sebagai warna tetap di colors.xml
         (v1.0.28: hijau TB/TC, dulu oranye v2rayNG). Dipakai semua
         chip di layar Edit server (protokol, SSH method, Xray
         method) supaya satu komponen yang sama seperti v2rayNG. -->
    <style name="Widget.TaptapNG.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIcon">@drawable/ic_action_done</item>
        <item name="checkedIconTint">@color/chip_selected_text</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <!-- Intentionally EMPTY overlay for dynamicColorThemeOverlay (see
         above): DynamicColors applies this to every activity theme at
         creation. Empty = no color changes, only the missing-attribute
         error goes away. parent="" means no parent on purpose — any
         parent with items would leak its attributes into the theme. -->
    <style name="ThemeOverlay.TaptapNG.DynamicColors" parent="">
    </style>
</resources>
